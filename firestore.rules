rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bgiyabliss73@gmail.com';
    }

    // Products & Collections: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Promo Codes: Anyone can read, only admin can write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Anyone can create (guest checkout). Authenticated users can read. Admin can write all.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Settings (Banners, etc.): Anyone can read, only admin can write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Anyone can read, authenticated users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Affiliates: Anyone can read (for code lookup), anyone can create (applications), admin can update/delete
    match /affiliates/{affiliateId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Affiliate Earnings: Anyone can read (for affiliate dashboard), system creates on order
    match /affiliate_earnings/{earningId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // User Coins: Anyone can read/write their own coin balance (keyed by email)
    match /user_coins/{email} {
      allow read: if true;
      allow write: if true;
    }

    // Coin Transactions: Anyone can read/create (system creates on order)
    match /coin_transactions/{txnId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Fallback block to ensure no other paths are open
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
